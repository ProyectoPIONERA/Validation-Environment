# Topology-specific runtime overrides for vm-distributed.

VM_COMMON_IP=192.168.122.64
VM_DATASPACE_IP=192.168.122.64
VM_COMPONENTS_IP=192.168.122.64
VM_PROVIDER_IP=192.168.122.134
VM_CONSUMER_IP=192.168.122.9
INGRESS_EXTERNAL_IP=192.168.122.64

CLUSTER_TYPE=k3s
K3S_INSTALL_EXEC=--disable=traefik
K3S_SERVICE_NAME=k3s
K3S_INGRESS_CONTROLLER=ingress-nginx
K3S_INGRESS_SERVICE_TYPE=LoadBalancer
K3S_INGRESS_HTTP_NODEPORT=31667
K3S_REPAIR_ON_LEVEL1=prompt
K3S_WRITE_KUBECONFIG_MODE=0644
TOPOLOGY_ROUTING_MODE=host

K3S_KUBECONFIG=/home/pionera/.kube/config
K3S_KUBECONFIG_PROVIDER=/home/pionera/.kube/k3s-pionera20.yaml
K3S_KUBECONFIG_CONSUMER=/home/pionera/.kube/k3s-pionera3.yaml

VM_PROVIDER_CONNECTORS=citycouncil
VM_CONSUMER_CONNECTORS=company

# Shared services: point to pioneer40 IP so remote cluster pods can reach them
DATABASE_HOSTNAME=192.168.122.64
VAULT_URL=http://192.168.122.64:8200
VT_URL=http://192.168.122.64:8200
