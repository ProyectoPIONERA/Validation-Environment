# VM addresses — one IP per role; set VM_EXTERNAL_IP as shared fallback
VM_EXTERNAL_IP=
VM_COMMON_IP=
VM_DATASPACE_IP=
VM_PROVIDER_IP=
VM_CONSUMER_IP=
VM_CONNECTORS_IP=
VM_COMPONENTS_IP=
VM_OBSERVABILITY_IP=
INGRESS_EXTERNAL_IP=

# Cluster runtime
CLUSTER_TYPE=k3s
K3S_INSTALL_EXEC=--disable=traefik
K3S_SERVICE_NAME=k3s
K3S_INGRESS_CONTROLLER=ingress-nginx
K3S_INGRESS_SERVICE_TYPE=LoadBalancer
K3S_INGRESS_HTTP_NODEPORT=
K3S_REPAIR_ON_LEVEL1=prompt
K3S_WRITE_KUBECONFIG_MODE=0644
TOPOLOGY_ROUTING_MODE=host

# Kubeconfig per cluster role — required for multi-cluster vm-distributed
# K3S_KUBECONFIG: common/core-control/components cluster (pioneer40)
# K3S_KUBECONFIG_PROVIDER: provider connectors cluster (pioneer20)
# K3S_KUBECONFIG_CONSUMER: consumer connectors cluster (pioneer3)
K3S_KUBECONFIG=
K3S_KUBECONFIG_PROVIDER=
K3S_KUBECONFIG_CONSUMER=

# Connector role assignment
VM_PROVIDER_CONNECTORS=
VM_CONSUMER_CONNECTORS=

# Shared services overrides — use VM IP so pods on remote clusters reach them
DATABASE_HOSTNAME=
VAULT_URL=
